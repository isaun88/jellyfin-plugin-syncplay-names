<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SyncPlayNames.Tests</AssemblyName>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)..\.packages</RestorePackagesPath>
    <DefineConstants Condition="Exists('..\.reference\Emby.Server.Implementations.dll')">$(DefineConstants);NATIVE_REFERENCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\src\Jellyfin.Plugin.SyncPlayNames.csproj" />
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" />
    <Reference Include="Emby.Server.Implementations" Condition="Exists('..\.reference\Emby.Server.Implementations.dll')">
      <HintPath>..\.reference\Emby.Server.Implementations.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
