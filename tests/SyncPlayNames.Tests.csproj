<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SyncPlayNames.Tests</AssemblyName>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)..\.packages</RestorePackagesPath>
    <NativeReferencePath>$(MSBuildThisFileDirectory)..\.reference\$(JellyfinVersion)\Emby.Server.Implementations.dll</NativeReferencePath>
    <DefineConstants Condition="Exists('$(NativeReferencePath)')">$(DefineConstants);NATIVE_REFERENCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\src\Jellyfin.Plugin.SyncPlayNames.csproj" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" />
    <Reference Include="Emby.Server.Implementations" Condition="Exists('$(NativeReferencePath)')">
      <HintPath>$(NativeReferencePath)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
